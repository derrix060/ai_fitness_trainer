{
  "mcpServers": {
    "intervals-icu": {
      "command": "/app/intervals-mcp",
      "env": {
        "INTERVALS_API_KEY": "${INTERVALS_API_KEY}",
        "INTERVALS_ATHLETE_ID": "${INTERVALS_ATHLETE_ID}"
      }
    },
    "trainingpeaks": {
      "command": "/app/trainingpeaks-mcp",
      "env": {
        "TRAININGPEAKS_ICAL_URL": "${TRAININGPEAKS_ICAL_URL}"
      }
    }
  }
}
